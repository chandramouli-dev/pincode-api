{
  "name": "pincode-api",
  "version": "1.0.0",
  "description": "India Pincode -> State, District, City API",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "fetch-data": "tsx scripts/fetch-data.ts",
    "build-snapshot": "tsx scripts/build-snapshot.ts",
    "refresh-data": "npm run fetch-data && npm run build-snapshot",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "test": "tsx scripts/smoke-test.ts",
    "test:vercel-handler": "tsx scripts/verify-vercel-handler.ts"
  },
  "dependencies": {
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
